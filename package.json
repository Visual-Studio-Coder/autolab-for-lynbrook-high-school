{
  "name": "autolab-for-lynbrook-high-school",
  "displayName": "Autolab for Lynbrook High School",
  "description": "This autolab extension, made for Lynbrook High School, allows for students to connect their Autolab accounts to this Visual Studio Code extension and download and submit assignments and view the scores/feedback without the need to open autolab in the browser, saving a significant amount of time and boosting productivity.",
  "version": "0.0.8",
  "icon": "resources/extension-icon.png",
  "publisher": "Visual-Studio-Coder",
  "repository": {
    "type": "git",
    "url": "https://github.com/Visual-Studio-Coder/autolab-for-lynbrook-high-school"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onView:autolabAssignments"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Autolab",
      "properties": {
        "autolab.workspacePath": {
          "type": "string",
          "default": "~/Documents/Autolab",
          "markdownDescription": "Path to the folder where assignments will be downloaded. [Select Folder...](command:autolab.setDownloadFolder)"
        },
        "autolab.sessionCookie": {
          "type": "string",
          "default": "",
          "description": "Legacy plain-text session cookie setting.",
          "markdownDeprecationMessage": "Use the **Autolab: Set Session Cookie** command to save this value in VS Code secure storage."
        },
        "autolab.courseName": {
          "type": "string",
          "default": "APCS-A-25",
          "description": "Course name from the Autolab course URL."
        },
        "autolab.userAgent": {
          "type": "string",
          "default": "",
          "description": "Optional browser User-Agent value for Cloudflare compatibility. Leave empty to use the current VS Code platform."
        },
        "autolab.authorName": {
          "type": "string",
          "default": "",
          "description": "Your name for Java file headers."
        },
        "autolab.period": {
          "type": "string",
          "default": "",
          "description": "Your class period."
        },
        "autolab.collaborators": {
          "type": "string",
          "default": "",
          "description": "Collaborators to list in Java file headers."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autolab-explorer",
          "title": "Autolab",
          "icon": "resources/autolab-icon.svg"
        }
      ]
    },
    "views": {
      "autolab-explorer": [
        {
          "id": "autolabAssignments",
          "name": "Assignments"
        }
      ]
    },
    "commands": [
      {
        "command": "autolab.refreshAssignments",
        "title": "Refresh Assignments",
        "icon": "$(refresh)"
      },
      {
        "command": "autolab.searchAssignments",
        "title": "Search Assignments",
        "icon": "$(search)"
      },
      {
        "command": "autolab.downloadAssignment",
        "title": "Download Assignment",
        "icon": "$(cloud-download)"
      },
      {
        "command": "autolab.submitAssignment",
        "title": "Submit Assignment",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "autolab.viewFeedback",
        "title": "View Feedback",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "autolab.openWriteup",
        "title": "Open Write-up",
        "icon": "$(book)"
      },
      {
        "command": "autolab.updateHeaders",
        "title": "Update Java Headers",
        "icon": "$(edit)"
      },
      {
        "command": "autolab.openAssignmentFolder",
        "title": "Open Assignment",
        "icon": "$(root-folder-opened)"
      },
      {
        "command": "autolab.openRootFolder",
        "title": "Open Autolab Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "autolab.setDownloadFolder",
        "title": "Set Download Folder",
        "category": "Autolab"
      },
      {
        "command": "autolab.setSessionCookie",
        "title": "Set Session Cookie",
        "category": "Autolab"
      },
      {
        "command": "autolab.clearSessionCookie",
        "title": "Clear Session Cookie",
        "category": "Autolab"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autolab.refreshAssignments",
          "when": "view == autolabAssignments",
          "group": "navigation"
        },
        {
          "command": "autolab.searchAssignments",
          "when": "view == autolabAssignments",
          "group": "navigation"
        },
        {
          "command": "autolab.openRootFolder",
          "when": "view == autolabAssignments",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "autolab.downloadAssignment",
          "when": "view == autolabAssignments && viewItem =~ /notDownloaded/",
          "group": "inline"
        },
        {
          "command": "autolab.submitAssignment",
          "when": "view == autolabAssignments && viewItem =~ /downloaded/",
          "group": "inline"
        },
        {
          "command": "autolab.viewFeedback",
          "when": "view == autolabAssignments && viewItem =~ /Graded/",
          "group": "inline"
        },
        {
          "command": "autolab.openWriteup",
          "when": "view == autolabAssignments"
        },
        {
          "command": "autolab.updateHeaders",
          "when": "view == autolabAssignments && viewItem =~ /downloaded/"
        },
        {
          "command": "autolab.openAssignmentFolder",
          "when": "view == autolabAssignments && viewItem =~ /downloaded/"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test:unit": "node --test test/unit.node.js",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "package:vsix": "vsce package",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/node-fetch": "^2.6.13",
    "@types/unzipper": "^0.10.11",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cheerio": "^1.1.2",
    "form-data": "^4.0.6",
    "node-fetch": "^2.7.0",
    "unzipper": "^0.12.3"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.1.0"
    }
  }
}
